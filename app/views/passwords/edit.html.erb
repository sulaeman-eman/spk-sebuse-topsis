<% content_for :title, "Ganti Kata Sandi" %>

<div class="login__brand">
  <span class="brand">
    <span class="brand__mark"><%= icon :pulse, size: 25 %></span>
  </span>
  <h1>Ganti kata sandi</h1>
  <p>Sandi baru berlaku maksimal 72 karakter.</p>
</div>

<div class="card">
  <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
    <div class="field">
      <%= form.label :password, "Kata sandi baru" %>
      <%= form.password_field :password, required: true, autofocus: true,
            autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Ulangi kata sandi baru" %>
      <%= form.password_field :password_confirmation, required: true,
            autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit "Simpan kata sandi", class: "btn btn--block" %>
  <% end %>

  <div class="login__hint">
    <%= link_to "Kembali ke halaman masuk", new_session_path %>
  </div>
</div>
