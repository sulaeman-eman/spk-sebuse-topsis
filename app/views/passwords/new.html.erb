<% content_for :title, "Lupa Kata Sandi" %>

<div class="login__brand">
  <span class="brand">
    <span class="brand__mark"><%= icon :pulse, size: 25 %></span>
  </span>
  <h1>Lupa kata sandi?</h1>
  <p>Masukkan email akun Anda, tautan penggantian sandi dikirimkan ke sana.</p>
</div>

<div class="card">
  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Alamat email" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </div>

    <%= form.submit "Kirim tautan penggantian", class: "btn btn--block" %>
  <% end %>

  <div class="login__hint">
    <%= link_to "Kembali ke halaman masuk", new_session_path %>
  </div>
</div>
