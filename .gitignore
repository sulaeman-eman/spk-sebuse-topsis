# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Naskah tugas akhir tidak diikutkan ke repositori. Berkasnya memuat data
# pribadi penulis (alamat, NPM, email) yang akan tersimpan permanen di riwayat
# git bila sekali saja ter-commit.
/*.pdf
/*.docx
/*.doc

# Seluruh isi docs/ tidak diikutkan ke repositori. Isinya naskah tugas akhir,
# gambar hasil render, HTML, dan PDF, yang berubah setiap kali revisi diterapkan.
# Berkasnya tetap ada di direktori kerja, dan dapat dibangun ulang melalui skrip
# pada direktori script/ yang tetap dilacak.
/docs/
/README.md

# Berkas pendukung aplikasi (manual penggunaan dan daftar kredensial) disimpan
# lokal saja. app_info/KREDENSIAL.md memuat email dan kata sandi akun, yang akan
# tersimpan permanen di riwayat git bila sekali saja ter-commit.
/app_info/
