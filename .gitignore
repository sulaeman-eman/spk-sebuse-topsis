# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Naskah tugas akhir tidak diikutkan ke repositori. Berkasnya memuat data
# pribadi penulis (alamat, NPM, email) yang akan tersimpan permanen di riwayat
# git bila sekali saja ter-commit. Polanya hanya berlaku di direktori utama,
# sehingga manual pengguna di docs/ tetap diikutkan.
/*.pdf
/*.docx
/*.doc


# Naskah revisi dan berkas turunannya disimpan lokal saja, tidak diikutkan ke
# repositori. Isinya berupa dokumen tugas akhir beserta gambar hasil render,
# bukan kode yang perlu dilacak riwayatnya.
/docs/Bab5/
/docs/RevisiFullTA1/
/docs/contoh_symbol_sequence.png
/docs/gambar/19-use-case-final.png
/docs/gambar/20-laporan-pdf-2.png
/docs/gambar/21-laporan-pdf-3.png
/docs/gambar/22-laporan-pdf-4.png

# Dokumen yang sebelumnya terlacak, kini disimpan lokal saja. Berkasnya tetap
# ada di direktori kerja, hanya tidak lagi diikutkan ke repositori.
/README.md
/docs/ManualPengguna/
/docs/RevisiBab4/
/docs/diagram/use-case.svg
/docs/gambar/14-laporan-pdf.png
